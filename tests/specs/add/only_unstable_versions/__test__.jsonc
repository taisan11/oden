{
  "tempDir": true,
  "tests": {
    "npm_package": {
      "steps": [
        {
          "args": "add npm:@denotest/unstable",
          "output": "add.out"
        }
      ]
    },
    "jsr_package": {
      "steps": [
        {
          "args": "add jsr:@denotest/unstable",
          "output": "add_jsr.out"
        },
        {
          "args": [
            "eval",
            "console.log(Deno.readTextFileSync('oden.json').trim())"
          ],
          "output": "add_jsr_oden.json.out"
        }
      ]
    }
  }
}
